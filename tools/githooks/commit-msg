#!/bin/sh
# commit-msg 钩子的启动层。真正的实现在 commit_msg.py，这一层只做一件事：
# **找到一个能用的 Python 3**。
#
# 为什么需要这一层（两条都是 Windows 上真会踩到、且都是 fail-closed 的）：
#
#   · Windows 上 python3 往往不在 PATH——python.org 的安装器装的是 python.exe
#     和 py.exe 启动器，没有 python3.exe。原先钩子的 shebang 写死
#     `#!/usr/bin/env python3`，找不到就 exit 127，git 把非零当成「检查没过」，
#     于是**连完全合规的提交也提不了**，报错还只有一句 command not found。
#   · `python` 在有些机器上是 Python 2，直接拿它跑会 SyntaxError——同样 exit 非零。
#     所以下面逐个候选都真跑一次版本检查，而不是看名字。
#
# 都找不到时**放行**并打提示，不是拦下。缺个解释器不该让整个仓库提交不了。
#
# 注意：.bat / .cmd 在这里帮不上忙——git 找的是名为 `commit-msg`（无扩展名）的文件，
# 而且在 Windows 上也是用自带的 sh 执行它，不会去找 `commit-msg.bat`。
# 所以启动层必须是 POSIX sh。安装脚本那种给人手动跑的东西才适合配 .cmd。
#
# 本文件必须是 LF 换行，见仓库根的 .gitattributes（CRLF 会让 sh 报
# "bad interpreter: ...^M"，同样是 fail-closed）。

hookdir=$(dirname "$0")
impl="$hookdir/commit_msg.py"
[ -f "$impl" ] || exit 0          # 实现不在也放行

# 让 Python 用 UTF-8 写 stderr。不设的话，stderr 是管道时 Python 走 locale 编码，
# 在中文/西欧 Windows 上整段提示会变成 \u63d0\u4ea4... 这种转义序列——人被拦下了，
# 却读不懂为什么。规则讲不清楚就等于没有规则。
PYTHONIOENCODING=utf-8
export PYTHONIOENCODING

for cand in python3 python "py -3"; do
    # 故意不加引号：要让 "py -3" 拆成两个词
    if $cand -c 'import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)' \
        >/dev/null 2>&1; then
        exec $cand "$impl" "$@"
    fi
done

printf '\n⚠ %s: 这台机器上找不到 Python 3（试过 python3 / python / py -3），本次跳过检查。\n' "commit-msg" >&2
printf '  规范见 CLAUDE.md「提交约定」与 AGENTS.md §0/§1，请自行对照；\n' >&2
printf '  装上 Python 3 之后会自动恢复。\n\n' >&2
exit 0
