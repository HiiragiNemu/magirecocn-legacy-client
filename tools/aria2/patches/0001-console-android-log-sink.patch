+#else  // !ANDROID_LOG_SINK
 #ifdef __MINGW32__
     consoleCout = std::make_shared<WinConsoleFile>(STD_OUTPUT_HANDLE);
     consoleCerr = std::make_shared<WinConsoleFile>(STD_ERROR_HANDLE);
@@ -63,6 +174,7 @@
