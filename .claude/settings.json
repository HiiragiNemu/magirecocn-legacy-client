{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/tools/agent-guard.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\"'"
          }
        ]
      }
    ]
  }
}
